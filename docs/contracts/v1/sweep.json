{
  "schema_version": 1,
  "tool_version": "<manifest-version>",
  "operation_id": "<per-invocation>",
  "status": "done",
  "tool": "sweep",
  "kind": "capability_contract",
  "contract_query": {
    "operation": "contract",
    "reads": [],
    "writes": []
  },
  "observation_scope": {
    "default_user_content": "metadata_only",
    "content_exceptions": [
      "explicit_tty_consent_text_prefix",
      "cross_device_copy"
    ],
    "symlinks": "refuse_or_skip",
    "environment": [
      "HOME",
      "TMPDIR",
      "ETUDE_STATE_DIR",
      "ETUDE_JOURNAL_KEY",
      "SWEEP_GRACE_SECS"
    ],
    "subprocess_environment": "inherited"
  },
  "mutation_scope": {
    "operations": [
      {
        "operation": "scan",
        "reads": [
          "selected_tree_metadata",
          "ancestor_metadata",
          "project_marker_names"
        ],
        "writes": []
      },
      {
        "operation": "scan_with_inspect_content",
        "reads": [
          "selected_tree_metadata",
          "ancestor_metadata",
          "project_marker_names",
          "consented_text_prefixes"
        ],
        "writes": []
      },
      {
        "operation": "apply",
        "reads": [
          "selected_tree_metadata",
          "ancestor_metadata",
          "project_marker_names",
          "journal_key",
          "cross_device_source_bytes"
        ],
        "writes": [
          "selected_tree_entries",
          "journal_store",
          "keychain_if_no_supplied_key"
        ]
      },
      {
        "operation": "review",
        "reads": [
          "selected_tree_metadata",
          "ancestor_metadata",
          "project_marker_names",
          "terminal_input",
          "journal_key",
          "cross_device_source_bytes"
        ],
        "writes": [
          "selected_tree_entries",
          "journal_store",
          "keychain_if_no_supplied_key"
        ]
      },
      {
        "operation": "undo",
        "reads": [
          "journal_store",
          "journal_key",
          "journal_recorded_paths_metadata",
          "cross_device_source_bytes"
        ],
        "writes": [
          "journal_recorded_entries",
          "journal_store",
          "empty_group_directories",
          "keychain_if_no_supplied_key"
        ]
      },
      {
        "operation": "forget",
        "reads": [
          "journal_store_metadata",
          "terminal_input"
        ],
        "writes": [
          "sweep_journals",
          "shared_keychain_key_if_authorized"
        ]
      },
      {
        "operation": "verify",
        "reads": [
          "journal_store_metadata",
          "ancestor_metadata"
        ],
        "writes": []
      },
      {
        "operation": "lesson",
        "reads": [],
        "writes": []
      }
    ],
    "startup": {
      "operation": "startup_except_contract",
      "reads": [
        "journal_store_metadata",
        "legacy_state_metadata"
      ],
      "writes": [
        "legacy_state_migration",
        "expired_journals_all_tools"
      ]
    }
  },
  "network": {
    "policy": "none",
    "runtime_enforcement": "none",
    "subprocesses": [
      "/usr/bin/security"
    ],
    "subprocess_network_verified": false
  },
  "overwrite": {
    "user_destinations": "refused",
    "owned_state": "journal_updates_replace"
  },
  "deletion": {
    "source_entries": "relocation_and_size_checked_copy_unlink",
    "user_payloads": "never",
    "owned_artifacts": [
      "expired_journals_all_tools",
      "sweep_journals_on_forget",
      "authorized_shared_key",
      "empty_group_directories",
      "case_probe_files"
    ]
  },
  "reversibility": {
    "mode": "conditional_journal_restore",
    "conditions": [
      "readable_journal",
      "same_key",
      "unchanged_items",
      "vacant_original_paths",
      "journal_not_expired",
      "journal_progress_writable"
    ],
    "disabled_by": [
      "--no-journal",
      "journal_or_key_loss"
    ]
  },
  "persistent_state": {
    "journal_store": "ETUDE_STATE_DIR_or_HOME/Library/Application Support/etudes",
    "journal_namespace": "sweep",
    "journal_ttl_days": 30,
    "key": "supplied_environment_or_shared_login_keychain",
    "result_artifacts": [
      "group_directories"
    ]
  },
  "formats": {
    "filesystem_handling": "visible_regular_files_by_metadata_any_extension",
    "content_inspection": {
      "supported": [
        ".txt",
        ".md",
        ".csv",
        ".log",
        ".json",
        ".xml",
        ".rtf",
        ".eml",
        ".vcf",
        ".ini",
        ".conf",
        ".yml",
        ".yaml",
        ".tex",
        ".tsv"
      ],
      "unsupported": [
        ".pdf",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".ppt",
        ".pptx",
        ".zip",
        ".tar",
        ".gz",
        ".jpg",
        ".png"
      ],
      "unlisted": "unsupported",
      "matching": "case_insensitive_suffix"
    },
    "archive_extraction": {
      "supported": [],
      "unsupported": [
        "all"
      ],
      "unlisted": "unsupported",
      "matching": "case_insensitive_suffix"
    }
  },
  "limits": {
    "platform": "macos",
    "inspection_max_bytes": 1048576,
    "extraction_budget": "not_applicable"
  },
  "evidence": {
    "kind": "declaration_not_receipt",
    "access_verified": false,
    "witness": "scripts/check-tool-contracts.py"
  }
}
