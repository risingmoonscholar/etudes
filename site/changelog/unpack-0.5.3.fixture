{
  "_about": "The test folder and commands for the unpack 0.5.3 entry. scripts/release-runs.py runs setup with /bin/sh -eu inside an empty scratch folder, once per build, then each command in that folder in order. show lists, per build, the whole lines of the output the page shows: each regular expression picks the next line it matches. result names the files listed under each side after its commands; new means only files that were not there before the commands ran. next runs on the after build only, after its commands.",
  "folder": "lone.zip",
  "kind": "synthetic archive",
  "describe": "a zip archive that holds notes.txt and shortcut, a link to /etc/passwd",
  "setup": [
    "# lone.zip holds notes.txt and shortcut, a symbolic link to /etc/passwd,",
    "# stored as a link by macOS zip -y. Only the archive is left in the folder.",
    "mkdir src",
    "printf 'notes\\n' > src/notes.txt",
    "ln -s /etc/passwd src/shortcut",
    "(cd src && /usr/bin/zip -q -y ../lone.zip notes.txt shortcut)",
    "rm -r src"
  ],
  "runs": [
    {
      "command": "unpack lone.zip",
      "show": {
        "before": [
          "^  Extracted to ",
          "^  2 entries$"
        ],
        "after": [
          "^unpack: REFUSED",
          "^create\\.$",
          "^  symlink: shortcut$",
          "^Nothing was extracted\\."
        ]
      }
    }
  ],
  "result": {
    "before": {
      "label": "Left on disk",
      "glob": "lone/*"
    },
    "after": {
      "label": "Nothing was extracted",
      "glob": "lone/*"
    }
  },
  "next": {
    "command": "unpack lone.zip --list",
    "show": [
      "entries in lone$",
      "^  notes\\.txt$",
      "^  shortcut$",
      "unsafe path",
      "^    symlink: shortcut$"
    ]
  }
}
